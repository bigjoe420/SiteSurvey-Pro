# =============================================================================
# SiteSurvey Pro — sdkconfig.defaults
# NM-CYD-C5: ESP32-C5, 16MB Flash, 8MB PSRAM, Wi-Fi 6
# =============================================================================

# -----------------------------------------------------------------------------
# Target
# -----------------------------------------------------------------------------
CONFIG_IDF_TARGET_ESP32C5=y

# -----------------------------------------------------------------------------
# Flash
# -----------------------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# -----------------------------------------------------------------------------
# Partition Table (custom for 16MB)
# -----------------------------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partitions.csv"

# -----------------------------------------------------------------------------
# PSRAM (8MB on NM-CYD-C5; ESP32-C5 supports QUAD mode only)
# -----------------------------------------------------------------------------
CONFIG_SPIRAM=y
# PSRAM speed: stay at the 40 MHz default. 80 MHz measured faster on the
# bench (77 vs 92 ms/frame) but proved UNSTABLE on this board (2026-09-26
# owner report): splash text flashing, ghosting behind moving graphics,
# background glow, reset on Settings tap — classic MSPI timing corruption.
# CONFIG_SPIRAM_SPEED_80M is not set
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
# Memtest costs ~1.8 s at boot (8 MB @ 40 MHz) and the pre-app backlight
# window is user-visible — keep it off for a clean boot
# CONFIG_SPIRAM_MEMTEST is not set

# -----------------------------------------------------------------------------
# Wi-Fi — aggressive reductions to free DMA-capable RAM for SDSPI + NimBLE
# -----------------------------------------------------------------------------
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=2
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=2
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=4
CONFIG_ESP_WIFI_TX_BA_WIN=2
CONFIG_ESP_WIFI_RX_BA_WIN=2

# -----------------------------------------------------------------------------
# Bluetooth — NimBLE (lightweight stack for observer/scanner mode)
# -----------------------------------------------------------------------------
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# Disable Bluedroid entirely
# CONFIG_BT_BLUEDROID_ENABLED is not set
# Minimise NimBLE RAM: we only scan, never connect or bond
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=0
CONFIG_BT_NIMBLE_MAX_CCCDS=0
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=0
# Observer-only: scan_ble.cpp uses only ble_gap_disc / ble_hs_adv_parse_fields.
# Dropping the connection/GATT/security roles frees controller+host RAM,
# which fixes BLE_ERR_MEM_CAPACITY (rc=519) on v6.1 with Wi-Fi coenabled.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
# NOTE: trimming the transport buffers (ACL/EVT/mSys) to free internal DMA
# RAM was tried 2026-09-26 and BROKE scanning: BLE_ERR_MEM_CAPACITY (rc=519)
# at every scan start. Do not reduce these without re-testing BLE thoroughly.
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=n
CONFIG_BT_NIMBLE_GATT_SERVER=n
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n

# -----------------------------------------------------------------------------
# FreeRTOS
# -----------------------------------------------------------------------------
CONFIG_FREERTOS_UNICORE=n
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL=3

# -----------------------------------------------------------------------------
# FATFS (SD card long filenames for session logs)
# -----------------------------------------------------------------------------
CONFIG_FATFS_LONG_NAMES=y

# -----------------------------------------------------------------------------
# LVGL v9 (managed component)
# -----------------------------------------------------------------------------
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_20=y

# -----------------------------------------------------------------------------
# Compiler
# -----------------------------------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_DEFAULT=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y

# -----------------------------------------------------------------------------
# Console — Hardening
# -----------------------------------------------------------------------------
# Disable secondary USB-SERIAL-JTAG console. When enabled, printk / ESP_LOG
# to this channel BLOCK the calling task if no monitor is attached to drain
# COM7. This caused ui_task freezes during per-event diag logging (2026-08-31).
# Primary UART console (USB-OTG-Serial, CDC) remains active for flash/monitor.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# LVGL memory pool — reverted to 64 KB. The 96 KB bump caused NimBLE to fail with
# BLE_ERR_MEM_CAPACITY (0x207) because it stole too much internal RAM. NULL guards
# in the UI code now handle any lv_*_create failures gracefully instead of hanging.
# when multiple screens are cached (Settings keyboard is heavy).
CONFIG_LV_MEM_SIZE_KILOBYTES=64
CONFIG_LV_MEM_POOL_EXPAND_SIZE_KILOBYTES=256

# Scroll smoothness (2026-09-26 audit):
#  - Refresh period 33 ms (30 fps) -> 16 ms (60 fps). Frame pacing is gated by
#    render time anyway; the 33 ms floor just added dead time between frames.
#  - RVV assembly blends: C5 has the vector extension; LVGL 9.5 ships RVV asm
#    for the sw draw unit. Off by default, costs nothing at runtime.
CONFIG_LV_DEF_REFR_PERIOD=16
# RVV asm A/B test (2026-09-26): reverted to NONE — frame probe showed
# ~17 ms avg CPU render per frame with RVV on, suspect slow vector blends on
# C5. Re-enable only if measurements clear it.
CONFIG_LV_DRAW_SW_ASM_NONE=y

# Disable LVGL NULL-pointer asserts. When OOM strikes, lv_obj_create returns NULL
# instead of hanging in while(1). Existing NULL guards in the UI code handle it.
# CONFIG_LV_USE_ASSERT_NULL is not set

# -----------------------------------------------------------------------------
# Application version
# -----------------------------------------------------------------------------
# Fixed version string baked into every image (shown on Settings > Firmware
# and used by the OTA same-version warning). Bump before each release and tag
# the commit with the same number.
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="1.0.0"

# Core dump to flash costs ~2 KB of internal RAM at boot and pushed the app
# to 0-8 bytes of internal DMA RAM — every display SPI command then failed
# and the UI froze on the splash screen (2026-09-26). Keep coredump off; the
# Settings-tap crash must be caught over serial instead.
# CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH is not set
