# =============================================================================
# SiteSurvey Pro — sdkconfig.defaults
# NM-CYD-C5: ESP32-C5, 16MB Flash, 8MB PSRAM, Wi-Fi 6
# =============================================================================

# -----------------------------------------------------------------------------
# Target
# -----------------------------------------------------------------------------
CONFIG_IDF_TARGET_ESP32C5=y

# -----------------------------------------------------------------------------
# Flash
# -----------------------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# -----------------------------------------------------------------------------
# Partition Table (custom for 16MB)
# -----------------------------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/partitions.csv"

# -----------------------------------------------------------------------------
# PSRAM (8MB on NM-CYD-C5; ESP32-C5 supports QUAD mode only)
# -----------------------------------------------------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Memtest costs ~1.8 s at boot (8 MB @ 40 MHz) and the pre-app backlight
# window is user-visible — keep it off for a clean boot
# CONFIG_SPIRAM_MEMTEST is not set

# -----------------------------------------------------------------------------
# Wi-Fi
# -----------------------------------------------------------------------------
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=y
# Aggressive buffer reductions to free internal RAM for NimBLE coexistence
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
CONFIG_ESP_WIFI_TX_BA_WIN=4
CONFIG_ESP_WIFI_RX_BA_WIN=4

# -----------------------------------------------------------------------------
# Bluetooth — NimBLE (lightweight stack for observer/scanner mode)
# -----------------------------------------------------------------------------
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# Disable Bluedroid entirely
# CONFIG_BT_BLUEDROID_ENABLED is not set
# Minimise NimBLE RAM: we only scan, never connect or bond
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=0
CONFIG_BT_NIMBLE_MAX_CCCDS=0
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=0

# -----------------------------------------------------------------------------
# FreeRTOS
# -----------------------------------------------------------------------------
CONFIG_FREERTOS_UNICORE=n

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL=3

# -----------------------------------------------------------------------------
# FATFS (SD card long filenames for session logs)
# -----------------------------------------------------------------------------
CONFIG_FATFS_LONG_NAMES=y

# -----------------------------------------------------------------------------
# LVGL v9 (managed component)
# -----------------------------------------------------------------------------
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y

# -----------------------------------------------------------------------------
# Compiler
# -----------------------------------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_DEFAULT=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y
